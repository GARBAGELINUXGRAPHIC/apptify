{
  "name": "apptify",
  "version": "0.2.0",
  "description": "An Apple-inspired, responsive Vue 3 component library with Vuetify ripple.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/apptify.js",
  "module": "./dist/apptify.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apptify.js"
    },
    "./style.css": "./dist/apptify.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "npm run build && vite build --config vite.consumer.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.9.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "@tanstack/virtual-core": "^3.17.11",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8",
    "vuetify": "^3.9.0"
  }
}
