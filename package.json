{
  "name": "apptify",
  "version": "0.5.4",
  "description": "An Apple-inspired, responsive Vue 3 component library.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GARBAGELINUXGRAPHIC/apptify.git"
  },
  "homepage": "https://github.com/GARBAGELINUXGRAPHIC/apptify#readme",
  "bugs": {
    "url": "https://github.com/GARBAGELINUXGRAPHIC/apptify/issues"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "tooling",
    "templates/playground"
  ],
  "main": "./dist/apptify.js",
  "module": "./dist/apptify.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apptify.js"
    },
    "./style.css": "./dist/apptify.css",
    "./vite": {
      "types": "./tooling/vite.d.ts",
      "import": "./tooling/vite.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "npm run prepack && vite build --config vite.consumer.config.ts && node tooling/test-playground-package.mjs",
    "test:create": "node tooling/test-create-apptify.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:playground": "node tooling/prepare-playground.mjs",
    "prepack": "node tooling/prepare-package.mjs"
  },
  "peerDependencies": {
    "vite-plugin-pages": "^0.32.4",
    "vue": "^3.5.0",
    "vuetify": "^3.9.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "@tanstack/virtual-core": "^3.17.11",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/repl": "4.7.2",
    "@vue/test-utils": "^2.4.6",
    "es-module-shims": "^2.8.4",
    "esbuild": "^0.25.12",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.28",
    "typescript": "^5.8.2",
    "vite": "^6.3.4",
    "vite-plugin-pages": "^0.32.5",
    "vitest": "^4.1.11",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.8",
    "vuetify": "^3.9.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-pages": {
      "optional": true
    }
  },
  "bin": {
    "apptify-playground": "./tooling/create-playground.mjs"
  }
}
